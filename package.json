{
  "name": "1section",
  "version": "1.0.0",
  "private": true,
  "description": "1section.com - multi-niche landing pages with Paddle one-time purchases and admin dashboard",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client",
    "typecheck": "npm run typecheck -w client",
    "lint": "eslint .",
    "test": "npm run test -w client",
    "prisma:generate": "npm run prisma:generate -w client",
    "prisma:migrate": "npm run prisma:migrate -w client",
    "prisma:deploy": "npm run prisma:deploy -w client",
    "db:seed": "npm run db:seed -w client"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
