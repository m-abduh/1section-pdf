# ============================================================
# 1section — environment template
#   cp .env.example .env
#
# Hanya 4 var yang WAJIB: DATABASE_URL, JWT_SECRET,
# PADDLE_API_KEY, PADDLE_WEBHOOK_SECRET.
# Semua var lain punya default di src/lib/server/config/env.ts.
# ============================================================

# ---- Wajib (server) ----
DATABASE_URL=postgresql://user:password@localhost:5432/1section?schema=public
# Isi string acak kuat (min 16 char). Jangan pakai contoh/placeholder.
JWT_SECRET=
PADDLE_API_KEY=pdl_sdbx_apikey_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Paddle (opsional) ----
# PADDLE_ENV=sandbox            # sandbox | production
# JWT_EXPIRES_IN=7d

# ---- Client/browser (di-inline saat build) ----
# Dev: localhost:3000 (mis. finance.localhost:3000) — Prod: 1section.com
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# NEXT_PUBLIC_PADDLE_ENV=sandbox
# NEXT_PUBLIC_SITE_NAME=1section
# NEXT_PUBLIC_SITE_TAGLINE=Practical learning for the problems that actually matter
# NEXT_PUBLIC_USE_SUBDOMAINS=true
# NEXT_PUBLIC_SOCIAL_HANDLE_PREFIX=1section.
# NEXT_PUBLIC_API_URL=           # kosong = same-origin

# ---- Batas unduhan & tautan akses (opsional, nilai default) ----
# DOWNLOAD_TOKEN_TTL_HOURS=72
# DOWNLOAD_MAX_HITS=5
# DOWNLOAD_SIGNED_URL_TTL_MINUTES=10
# ORDER_ACCESS_TTL_HOURS=720

# ---- Penyimpanan PDF privat (Cloudinary) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=1section/bundles

# ---- Akun admin seed (npm run db:seed) ----
ADMIN_EMAIL=admin@1section.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrator
