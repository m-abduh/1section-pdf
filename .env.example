# ---- Public (browser) vars ----
# Kosong = same-origin (default). Isi URL absolut hanya bila API di host terpisah.
NEXT_PUBLIC_API_URL=
# Dev: localhost:3000 (mis. finance.localhost:3000) — Produksi: 1section.com (mis. finance.1section.com)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_SITE_NAME=1section
NEXT_PUBLIC_SOCIAL_HANDLE_PREFIX=1section.
NEXT_PUBLIC_USE_SUBDOMAINS=true
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# ---- Server-only vars ----
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/section?schema=public

CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:3000
ROOT_DOMAIN=1section.com

JWT_SECRET=change-me-to-a-long-random-string-min-16-chars
JWT_EXPIRES_IN=7d

PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PADDLE_TAX_CATEGORY=standard

DOWNLOAD_TOKEN_TTL_HOURS=72
DOWNLOAD_MAX_HITS=5
DOWNLOAD_SIGNED_URL_TTL_MINUTES=10
ACCESS_LINK_TTL_MINUTES=60
ORDER_ACCESS_TTL_HOURS=720

# Private PDF storage (authenticated delivery + signed URLs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=1section/bundles

# Transactional email for magic access links (resend | log)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=1section <no-reply@1section.com>

# Set to true only in automated tests
RATE_LIMIT_DISABLED=false

# Seeded admin account (used by `npm run db:seed`)
ADMIN_EMAIL=admin@1section.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrator
